group_by(cluster)%>%
summarise_at(3:7,CI)
#This script analyses the clusters resulting from using lag lead imputation on scaled indicators
library(countrycode) #For standardizing country names
library(rnaturalearth)
library(ggplot2)
library(tidyr)
library(readxl)
