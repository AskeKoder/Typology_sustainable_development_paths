combine_normal_distributions <- function(mu1, sigma1, mu2, sigma2) {
# Calculate posterior mean using the formula:
mu_posterior <- (sigma2^2 * mu1 + sigma1^2 * mu2) / (sigma1^2 + sigma2^2)
# Calculate posterior variance using the formula:
sigma_posterior_squared <- (sigma1^2 * sigma2^2) / (sigma1^2 + sigma2^2)
# Return the posterior mean and standard deviation
list(
mean = mu_posterior,
sd = sqrt(sigma_posterior_squared)
)
}
