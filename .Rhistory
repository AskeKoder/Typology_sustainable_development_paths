Baseline <- data[,1:56,69]
#Run experiments-----------------------------------------
#SPI baseline
Baseline <- data[,1:56,65]
#Run experiments-----------------------------------------
#SPI baseline
Baseline <- data[,c(1:56,65)]
#Run experiments-----------------------------------------
#SPI baseline
Baseline <- data[,c(1:56,68)]
#Run experiments-----------------------------------------
#SPI baseline
Baseline <- data[,c(1:56,68)]
results_baseline <- clusterData(Baseline, m=15,minInformation = 0.8)
#Run experiments-----------------------------------------
