#Panel Unit root test-----------------------------------------------------------------------------------
library(plm)
df_mod <- df %>%
mutate(logGHG = log(GHG),
logGDPcap = log(GDP_PPPcap),
logPOP = log(Population),
logTFP = TFP)%>%
group_by(iso3) %>%                  # ensure differences are within countries
arrange(Year, .by_group = TRUE) %>%
mutate(
dlogGHG = logGHG - dplyr::lag(logGHG,1)                 # first difference
)%>%
select(-TFP)
purtest(logGHG ~ 1, data = df_mod, index = c("iso3","Year"), test = "levinlin", lags = 2)
purtest(HDI ~ 1, data = df_mod, index = c("iso3","Year"), test = "levinlin", lags = 2)
df_mod
