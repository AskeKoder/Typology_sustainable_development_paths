#Compare clusters with HDI table-------------------------------------------------------------------
#Load HDI data 2022
HDI_raw <- read_xlsx("Data_WellBeing/HDR23-24_Statistical_Annex_HDI_Table (1).xlsx")%>%
setNames(1:length(.))%>%
select(!c(4,6,8,10,12,14,15))%>%
setNames(.[4,])
colnames(HDI_raw)[1] <- "HDI rank"
colnames(HDI_raw)[2] <- "Country"
HDI <- HDI_raw %>%
slice(-c(1,2,3,4,5,6))%>%
drop_na()
